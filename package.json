{
  "name": "file-manager",
  "version": "0.1.0",
  "description": "Keyboard-first two-panel file manager (Tauri + Rust). Frontend is a thin, swappable Svelte renderer.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
