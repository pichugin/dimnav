{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dimnav",
  "identifier": "com.dimnav.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dimnav",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCODlDMDZFRkM4NERBMDUKUldRRjJvVDhic0NKR3p3YloxTzdoRVFIcmdqZVdzLzNYRTlDVVZqN1k4QmxlRlpJY2VnNUc5NXkK",
      "endpoints": [
        "https://github.com/pichugin/dimnav/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "public.app-category.utilities",
    "copyright": "© 2026 Dmitry Pichugin",
    "shortDescription": "Keyboard-first two-panel file manager",
    "longDescription": "A fast, keyboard-first two-panel file manager for macOS in the Norton Commander lineage, with a built-in terminal, viewer, and editor.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist"
    }
  }
}
